# Prompt 6 : deux environnements Supabase distincts, deux fichiers reels
# a creer localement (jamais commites - voir .gitignore) :
#
# .env.development -> lu par `npm run dev` (mode=development) et les
#                      deploiements Vercel Preview. DOIT pointer vers le
#                      projet Supabase de DEV.
# .env.production  -> lu par `npm run build` (mode=production) et le
#                      deploiement Vercel Production. DOIT pointer vers le
#                      projet Supabase de PRODUCTION (donnees reelles).
#
# Ne jamais faire pointer .env.development vers le projet de production :
# c'est exactement la derive que ce prompt corrige.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
